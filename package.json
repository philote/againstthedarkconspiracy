{
  "name": "atdc",
  "version": "1.0.0",
  "description": "CSS compiler for the Against the Dark Conspiracy system",
  "scripts": {
    "build": "sass scss/atdc.scss css/atdc.css --style=expanded --no-source-map",
    "watch": "sass scss/atdc.scss css/atdc.css --style=expanded --source-map --watch",
    "pushLDBtoJSON": "node ./tools/pushLDBtoJSON.mjs",
    "pullJSONtoLDB": "node ./tools/pullJSONtoLDB.mjs",
    "createSymlinks": "node ./tools/create-symlinks.mjs"
  },
  "author": "ephson",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "js-yaml": "^5.4.3",
    "sass": "^1.105.1"
  }
}
